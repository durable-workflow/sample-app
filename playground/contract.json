{
  "schema": "durable-workflow.sample-app.playground",
  "schema_version": 4,
  "interface": "scripts/playground",
  "choices": [
    "php",
    "python",
    "rust"
  ],
  "source_ownership": "caller",
  "artifact_source": "polyglot/qualified-artifact-tuple.json",
  "runtime": {
    "default": "local",
    "targets": {
      "local": {
        "server_distribution": "published-image",
        "server_artifact": "server",
        "waterline_distribution": "published-service-image",
        "waterline_artifact": "waterline",
        "isolated_state_per_journey": true,
        "requires_external_access": false
      },
      "managed": {
        "service_orchestration": "external",
        "required_arguments": [
          "--runtime-url",
          "--namespace",
          "--task-queue"
        ],
        "credential_roles": {
          "worker": "DURABLE_WORKFLOW_WORKER_TOKEN",
          "client": "DURABLE_WORKFLOW_CLIENT_TOKEN"
        }
      }
    }
  },
  "proof": {
    "required_status": "completed",
    "required_history_events": [
      "WorkflowStarted",
      "ActivityScheduled",
      "ActivityCompleted",
      "WorkflowCompleted"
    ],
    "requires_worker_registration": true,
    "runtime": {
      "local": {
        "selected_waterline_run": {
          "requirement": "required"
        }
      },
      "managed": {
        "selected_waterline_run": {
          "requirement": "omitted",
          "reason": "managed-waterline-not-validated-by-sdk-playground"
        }
      }
    }
  },
  "scenarios": {
    "php": {
      "integration": "laravel-bridge",
      "workflow_type": "sample-app.playground.php.authored-workflow",
      "activity_type": "sample-app.playground.php.authored-activity",
      "task_queue": "sample-app-playground-php-{run_suffix}",
      "workflow_id_prefix": "sample-app-playground-php",
      "input": {
        "name": "Durable Workflow"
      },
      "test_command": ["php", "{source}/test.php"],
      "worker_command": ["php", "{source}/worker.php"],
      "start_command": ["php", "{source}/client.php"],
      "expected_result": {
        "greeting": "Hello, Durable Workflow, from the Sample App PHP playground",
        "input": {
          "name": "Durable Workflow"
        },
        "activity_runtime": "php",
        "workflow_runtime": "php"
      }
    },
    "python": {
      "integration": "framework-neutral",
      "workflow_type": "sample-app.playground.python.authored-workflow",
      "activity_type": "sample-app.playground.python.authored-activity",
      "task_queue": "sample-app-playground-python-{run_suffix}",
      "workflow_id_prefix": "sample-app-playground-python",
      "input": {
        "name": "Durable Workflow"
      },
      "worker_command": ["python", "{source}/worker.py"],
      "start_command": ["python", "{source}/client.py"],
      "expected_result": {
        "greeting": "Hello, Durable Workflow, from the Sample App Python playground",
        "input": {
          "name": "Durable Workflow"
        },
        "activity_runtime": "python",
        "workflow_runtime": "python"
      }
    },
    "rust": {
      "integration": "framework-neutral",
      "workflow_type": "sample-app.playground.rust.authored-workflow",
      "activity_type": "sample-app.playground.rust.authored-activity",
      "task_queue": "sample-app-playground-rust-{run_suffix}",
      "workflow_id_prefix": "sample-app-playground-rust",
      "input": {
        "name": "Durable Workflow"
      },
      "worker_command": [
        "cargo", "run", "--quiet", "--locked", "{cargo_offline}",
        "--manifest-path", "{source}/Cargo.toml", "--bin", "worker"
      ],
      "start_command": [
        "cargo", "run", "--quiet", "--locked", "{cargo_offline}",
        "--manifest-path", "{source}/Cargo.toml", "--bin", "client"
      ],
      "expected_result": {
        "greeting": "Hello, Durable Workflow, from the Sample App Rust playground",
        "input": {
          "name": "Durable Workflow"
        },
        "activity_runtime": "rust",
        "workflow_runtime": "rust"
      }
    }
  }
}
