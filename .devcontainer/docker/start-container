#!/usr/bin/env bash

set -euo pipefail

identity_readiness_marker=/run/sample-app/identity-ready
runtime_uid="$(id -u)"
if [[ "$runtime_uid" == 0 ]]; then
    rm -f "$identity_readiness_marker"
fi

install_locked_composer_dependencies() {
    local -a command_prefix=("$@")

    if ! "${command_prefix[@]}" composer validate \
        --strict \
        --check-lock \
        --no-check-all \
        --no-interaction; then
        printf 'Composer lock validation failed in %s. Regenerate and commit the lock file before rebuilding the Codespace.\n' \
            "$PWD" >&2
        return 1
    fi

    if [[ ! -s vendor/autoload.php ]]; then
        printf 'Image-seeded Composer dependencies are missing in %s. Rebuild the Codespace to recreate its dependency volume.\n' \
            "$PWD" >&2
        return 1
    fi

    if ! "${command_prefix[@]}" composer install \
        --prefer-dist \
        --no-progress \
        --no-interaction; then
        printf 'Composer dependency installation failed in %s. Review the Composer error above, then rebuild the Codespace.\n' \
            "$PWD" >&2
        return 1
    fi
}

prepare_project_permissions() {
    local project_dir="$PWD"
    local generated_dir

    if ! gosu laravel test -w "$project_dir" \
        || ! gosu laravel test -w "$project_dir/composer.json"; then
        chown -R laravel:laravel "$project_dir"
        return
    fi

    for generated_dir in "$project_dir/vendor" "$project_dir/node_modules"; do
        if [[ -d "$generated_dir" ]] && ! gosu laravel test -w "$generated_dir"; then
            chown -R laravel:laravel "$generated_dir"
        fi
    done
}

remap_laravel_uid() {
    local requested_uid="${SAMPLE_APP_UID:-}"
    local current_uid
    local existing_account

    [[ -n "$requested_uid" ]] || return 0

    if [[ ! "$requested_uid" =~ ^[1-9][0-9]*$ ]] || (( 10#$requested_uid > 2147483647 )); then
        echo "SAMPLE_APP_UID must be a positive, non-root decimal user ID." >&2
        return 1
    fi

    current_uid="$(id -u laravel)"
    [[ "$requested_uid" != "$current_uid" ]] || return 0

    existing_account="$(getent passwd "$requested_uid" | cut -d: -f1 || true)"
    if [[ -n "$existing_account" && "$existing_account" != "laravel" ]]; then
        echo "SAMPLE_APP_UID ${requested_uid} belongs to account ${existing_account}." >&2
        return 1
    fi

    usermod --uid "$requested_uid" laravel
    chown -R laravel:laravel /home/laravel /opt/sample-app-playground
}

prepare_docker_socket_access() {
    local socket=/var/run/docker.sock
    local socket_gid
    local socket_group

    [[ -S "$socket" ]] || return 0
    socket_gid="$(stat --format=%g "$socket")"
    socket_group="$(getent group "$socket_gid" | cut -d: -f1 || true)"

    if [[ -z "$socket_group" ]]; then
        socket_group=sample-app-docker
        groupadd --gid "$socket_gid" "$socket_group"
    fi

    usermod --append --groups "$socket_group" laravel
    if ! gosu laravel test -r "$socket" || ! gosu laravel test -w "$socket"; then
        echo "Docker socket access is not permission-safe for laravel (gid ${socket_gid})." >&2
        return 1
    fi
}

publish_identity_readiness() {
    local marker_directory
    local marker_temporary
    local socket_gid=absent

    marker_directory="$(dirname "$identity_readiness_marker")"
    install -d -m 0755 -o root -g root "$marker_directory"
    marker_temporary="$(mktemp "${identity_readiness_marker}.XXXXXX")"

    if [[ -S /var/run/docker.sock ]]; then
        socket_gid="$(stat --format=%g /var/run/docker.sock)"
    fi

    printf 'uid=%s\nsocket_gid=%s\n' "$(id -u laravel)" "$socket_gid" > "$marker_temporary"
    chown root:root "$marker_temporary"
    chmod 0444 "$marker_temporary"
    mv -f "$marker_temporary" "$identity_readiness_marker"
}

if [[ "$runtime_uid" == "0" ]]; then
    remap_laravel_uid
    prepare_docker_socket_access
    publish_identity_readiness

    ssh-keygen -A
    sshd -t

    prepare_project_permissions

    if [[ -f composer.json ]]; then
        install_locked_composer_dependencies gosu laravel
    fi

    if (( $# > 0 )); then
        exec gosu laravel "$@"
    fi

    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi

if [[ -f composer.json ]]; then
    install_locked_composer_dependencies
fi

if (( $# > 0 )); then
    exec "$@"
fi

exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
