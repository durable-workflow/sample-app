#!/usr/bin/env bash

set -euo pipefail

if [[ "$(id -u)" == "0" ]]; then
    ssh-keygen -A
    sshd -t

    if ! gosu laravel bash -c '
        test -w /var/www/html
        test ! -e /var/www/html/composer.json || test -w /var/www/html/composer.json
        test ! -d /var/www/html/vendor || test -w /var/www/html/vendor
        test ! -d /var/www/html/node_modules || test -w /var/www/html/node_modules
    '; then
        chown -R laravel:laravel /var/www/html
    fi

    if [[ -f composer.json ]]; then
        gosu laravel composer install --prefer-dist --no-progress --no-interaction
    fi

    if (( $# > 0 )); then
        exec gosu laravel "$@"
    fi

    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi

if [[ -f composer.json ]]; then
    composer install --prefer-dist --no-progress --no-interaction
fi

if (( $# > 0 )); then
    exec "$@"
fi

exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
