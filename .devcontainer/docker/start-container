#!/usr/bin/env bash

set -euo pipefail

identity_readiness_marker="${SAMPLE_APP_IDENTITY_READY_MARKER:-/run/sample-app/identity-ready}"
identity_stage_marker="${SAMPLE_APP_IDENTITY_STAGE_MARKER:-/run/sample-app/identity-stage}"
docker_socket="${SAMPLE_APP_DOCKER_SOCKET:-/var/run/docker.sock}"
local_group_file="${SAMPLE_APP_LOCAL_GROUP_FILE:-/etc/group}"
local_passwd_file="${SAMPLE_APP_LOCAL_PASSWD_FILE:-/etc/passwd}"
identity_operation_timeout_seconds="${SAMPLE_APP_IDENTITY_OPERATION_TIMEOUT_SECONDS:-15}"
laravel_home="${SAMPLE_APP_LARAVEL_HOME:-/home/laravel}"
prepared_playground_root="${SAMPLE_APP_PREPARED_PLAYGROUND_ROOT:-/opt/sample-app-playground}"

publish_identity_stage() {
    local stage="$1"
    local stage_directory
    local stage_temporary

    stage_directory="$(dirname "$identity_stage_marker")"
    install -d -m 0755 -o 0 -g 0 "$stage_directory"
    stage_temporary="$(mktemp "${identity_stage_marker}.XXXXXX")"
    printf '%s\n' "$stage" > "$stage_temporary"
    chown 0:0 "$stage_temporary"
    chmod 0444 "$stage_temporary"
    mv -f "$stage_temporary" "$identity_stage_marker"
}

run_bounded_identity_operation() {
    local description="$1"
    local status
    shift

    if [[ ! "$identity_operation_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
        echo 'SAMPLE_APP_IDENTITY_OPERATION_TIMEOUT_SECONDS must be a positive integer.' >&2
        return 2
    fi

    if timeout --kill-after=2s "${identity_operation_timeout_seconds}s" "$@"; then
        return 0
    else
        status=$?
    fi

    if (( status == 124 || status == 137 )); then
        printf '%s timed out after %ss. Check the local account files and Docker socket ownership, then rebuild the container.\n' \
            "$description" "$identity_operation_timeout_seconds" >&2
    else
        printf '%s failed with exit code %s. Check the local account files and Docker socket ownership, then rebuild the container.\n' \
            "$description" "$status" >&2
    fi

    return "$status"
}

install_locked_composer_dependencies() {
    local -a command_prefix=("$@")

    if ! "${command_prefix[@]}" composer validate \
        --strict \
        --check-lock \
        --no-check-all \
        --no-interaction; then
        printf 'Composer lock validation failed in %s. Regenerate and commit the lock file before rebuilding the Codespace.\n' \
            "$PWD" >&2
        return 1
    fi

    if [[ ! -s vendor/autoload.php ]]; then
        printf 'Image-seeded Composer dependencies are missing in %s. Rebuild the Codespace to recreate its dependency volume.\n' \
            "$PWD" >&2
        return 1
    fi

    if ! "${command_prefix[@]}" composer install \
        --prefer-dist \
        --no-progress \
        --no-interaction; then
        printf 'Composer dependency installation failed in %s. Review the Composer error above, then rebuild the Codespace.\n' \
            "$PWD" >&2
        return 1
    fi
}

prepare_project_permissions() {
    local project_dir="$PWD"
    local generated_dir

    if ! gosu laravel test -w "$project_dir" \
        || ! gosu laravel test -w "$project_dir/composer.json"; then
        chown -R laravel:laravel "$project_dir"
        return
    fi

    for generated_dir in "$project_dir/vendor" "$project_dir/node_modules"; do
        if [[ -d "$generated_dir" ]] && ! gosu laravel test -w "$generated_dir"; then
            chown -R laravel:laravel "$generated_dir"
        fi
    done
}

update_local_passwd_uid() {
    local account="$1"
    local requested_uid="$2"
    local passwd_temporary
    local status
    local updated_uid

    passwd_temporary="$(mktemp "${local_passwd_file}.XXXXXX")"
    if ! awk -F: -v OFS=: -v account="$account" -v uid="$requested_uid" '
        $1 == account {
            updated++
            $3 = uid
        }
        { print }
        END {
            if (updated != 1) {
                exit 65
            }
        }
    ' "$local_passwd_file" > "$passwd_temporary"; then
        rm -f "$passwd_temporary"
        echo "Local account file must define exactly one ${account} account: ${local_passwd_file}." >&2
        return 1
    fi

    chmod --reference="$local_passwd_file" "$passwd_temporary" || {
        status=$?
        rm -f "$passwd_temporary"
        return "$status"
    }
    chown --reference="$local_passwd_file" "$passwd_temporary" || {
        status=$?
        rm -f "$passwd_temporary"
        return "$status"
    }
    mv -f "$passwd_temporary" "$local_passwd_file" || {
        status=$?
        rm -f "$passwd_temporary"
        echo "Could not atomically replace the local account file: ${local_passwd_file}." >&2
        return "$status"
    }

    updated_uid="$(awk -F: -v account="$account" '$1 == account { print $3; exit }' "$local_passwd_file")"
    if [[ "$updated_uid" != "$requested_uid" ]]; then
        echo "Local account update did not persist uid ${requested_uid} for ${account}." >&2
        return 1
    fi
}

remap_laravel_uid() {
    local requested_uid="${SAMPLE_APP_UID:-}"
    local current_uid
    local current_gid
    local existing_account

    [[ -n "$requested_uid" ]] || return 0

    if [[ ! "$requested_uid" =~ ^[1-9][0-9]*$ ]] || (( 10#$requested_uid > 2147483647 )); then
        echo "SAMPLE_APP_UID must be a positive, non-root decimal user ID." >&2
        return 1
    fi

    if [[ ! -r "$local_passwd_file" ]]; then
        echo "Local account file is unreadable: ${local_passwd_file}." >&2
        return 1
    fi

    current_uid="$(awk -F: '$1 == "laravel" { print $3; exit }' "$local_passwd_file")"
    current_gid="$(awk -F: '$1 == "laravel" { print $4; exit }' "$local_passwd_file")"
    if [[ ! "$current_uid" =~ ^[1-9][0-9]*$ || ! "$current_gid" =~ ^[1-9][0-9]*$ ]]; then
        echo "Local account file does not define laravel: ${local_passwd_file}." >&2
        return 1
    fi
    [[ "$requested_uid" != "$current_uid" ]] || return 0

    publish_identity_stage remapping-laravel-uid

    existing_account="$(awk -F: -v uid="$requested_uid" '$3 == uid { print $1; exit }' "$local_passwd_file")"
    if [[ -n "$existing_account" && "$existing_account" != "laravel" ]]; then
        echo "SAMPLE_APP_UID ${requested_uid} belongs to account ${existing_account}." >&2
        return 1
    fi

    # usermod --uid recursively re-owns the user's home. Updating this
    # container-local file directly keeps prefetched SDK caches off startup's
    # critical path; their stable group ownership provides continued access.
    update_local_passwd_uid laravel "$requested_uid"
    publish_identity_stage preparing-laravel-home
    chown "${requested_uid}:${current_gid}" "$laravel_home"
    if [[ -d "$laravel_home/.ssh" ]]; then
        chown -R "${requested_uid}:${current_gid}" "$laravel_home/.ssh"
    fi

    publish_identity_stage verifying-prepared-toolchain-access
    for prepared_path in \
        "$laravel_home/.cargo" \
        "$laravel_home/.composer" \
        "$prepared_playground_root"; do
        [[ -e "$prepared_path" ]] || continue
        if ! gosu laravel test -r "$prepared_path" \
            || ! gosu laravel test -w "$prepared_path"; then
            echo "Prepared toolchain path is not accessible after the uid transition: ${prepared_path}. Rebuild the container image." >&2
            return 1
        fi
    done
}

prepare_docker_socket_access() {
    local socket_gid
    local socket_group

    publish_identity_stage locating-docker-socket-group

    [[ -S "$docker_socket" ]] || return 0
    if [[ ! -r "$local_group_file" ]]; then
        echo "Local group file is unreadable: ${local_group_file}." >&2
        return 1
    fi

    socket_gid="$(stat --format=%g "$docker_socket")"
    socket_group="$(awk -F: -v gid="$socket_gid" '$3 == gid { print $1; exit }' "$local_group_file")"

    if [[ -z "$socket_group" ]]; then
        socket_group=sample-app-docker
        publish_identity_stage creating-docker-socket-group
        run_bounded_identity_operation \
            "Creating Docker socket group ${socket_group} (gid ${socket_gid})" \
            groupadd --gid "$socket_gid" "$socket_group"
    fi

    publish_identity_stage adding-docker-socket-group
    run_bounded_identity_operation \
        "Adding laravel to Docker socket group ${socket_group} (gid ${socket_gid})" \
        usermod --append --groups "$socket_group" laravel

    publish_identity_stage verifying-docker-socket-access
    if ! run_bounded_identity_operation \
        "Verifying laravel can read the Docker socket (gid ${socket_gid})" \
        gosu laravel test -r "$docker_socket" \
        || ! run_bounded_identity_operation \
            "Verifying laravel can write the Docker socket (gid ${socket_gid})" \
            gosu laravel test -w "$docker_socket"; then
        echo "Docker socket access is not permission-safe for laravel (gid ${socket_gid})." >&2
        return 1
    fi

    publish_identity_stage docker-socket-access-ready
}

publish_identity_readiness() {
    local marker_directory
    local marker_temporary
    local prepared_uid
    local socket_gid=absent

    publish_identity_stage publishing-identity-readiness

    marker_directory="$(dirname "$identity_readiness_marker")"
    install -d -m 0755 -o 0 -g 0 "$marker_directory"
    prepared_uid="$(awk -F: '$1 == "laravel" { print $3; exit }' "$local_passwd_file")"
    if [[ ! "$prepared_uid" =~ ^[1-9][0-9]*$ ]]; then
        echo "Local account file does not define laravel: ${local_passwd_file}." >&2
        return 1
    fi
    marker_temporary="$(mktemp "${identity_readiness_marker}.XXXXXX")"

    if [[ -S "$docker_socket" ]]; then
        socket_gid="$(stat --format=%g "$docker_socket")"
    fi

    printf 'uid=%s\nsocket_gid=%s\n' "$prepared_uid" "$socket_gid" > "$marker_temporary"
    chown 0:0 "$marker_temporary"
    chmod 0444 "$marker_temporary"
    mv -f "$marker_temporary" "$identity_readiness_marker"
    publish_identity_stage identity-ready
}

initialize_identity_runtime() {
    local marker_directory
    local stage_directory

    marker_directory="$(dirname "$identity_readiness_marker")"
    stage_directory="$(dirname "$identity_stage_marker")"
    install -d -m 0755 -o 0 -g 0 "$marker_directory" "$stage_directory"
    rm -f "$identity_readiness_marker" "$identity_stage_marker"
    publish_identity_stage starting
}

start_container() {
    local runtime_uid

    umask 0002
    runtime_uid="$(id -u)"
    if [[ "$runtime_uid" == "0" ]]; then
        initialize_identity_runtime
        remap_laravel_uid
        prepare_docker_socket_access
        publish_identity_readiness

        ssh-keygen -A
        sshd -t

        prepare_project_permissions

        if [[ -f composer.json ]]; then
            install_locked_composer_dependencies gosu laravel
        fi

        if (( $# > 0 )); then
            exec gosu laravel "$@"
        fi

        exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
    fi

    if [[ -f composer.json ]]; then
        install_locked_composer_dependencies
    fi

    if (( $# > 0 )); then
        exec "$@"
    fi

    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

start_container "$@"
